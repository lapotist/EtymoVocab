{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Wiktionary": {
    "ApiUrl": "https://en.wiktionary.org/w/api.php",
    "UserAgent": "EtymoVocab/0.1 (https://github.com/lapotist/EtymoVocab) dotnet-HttpClient",
    "MaxConcurrency": 3,
    "TimeoutSeconds": 15,
    "MaxRetries": 2,
    "MaxRetryDelaySeconds": 5,
    "PageCacheMinutes": 30,
    "MissingPageCacheMinutes": 10
  },
  "Lookup": {
    "MaxUpstreamRequests": 6,
    "MaxAncestorRounds": 3,
    "ResultCacheMinutes": 30
  }
}
